# Pinned versions for the cognitive-stack services.
# Copy to .env and edit; compose reads from --env-file deploy/.env.
#
# Tag format: goreleaser strips the leading `v`, so tags on GHCR look
# like `0.3.0`, NOT `v0.3.0`.

# Published on GHCR:
MNEMOS_TAG=0.12.0
CHRONOS_TAG=0.3.0
NOUS_TAG=0.1.1
OLYMP_TAG=0.1.2

# Unpublished — built from sibling source. Override the parent dir
# containing the sibling repos if your tree isn't `olymp/../praxis/`.
OLYMP_STACK_ROOT=../..

# Praxis: still in development; no published image.
# PRAXIS_TAG=0.1.0
