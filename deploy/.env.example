# Pinned versions for the cognitive-stack services.
# Copy to .env and edit; compose reads from --env-file deploy/.env.
#
# Tag format: goreleaser strips the leading `v`, so tags on GHCR look
# like `0.3.0`, NOT `v0.3.0`.

# All five layers publish to ghcr.io/felixgeelhaar/<name>:
MNEMOS_TAG=0.13.0
CHRONOS_TAG=0.4.0
NOUS_TAG=0.3.0
PRAXIS_TAG=0.3.0
OLYMP_TAG=0.1.4

# Shared HMAC secret used to sign agent JWTs between Mnemos and Olymp.
# Mnemos uses it to verify; Olymp uses it to mint. Must be ≥32 bytes
# of hex (64 hex chars). Generate with: openssl rand -hex 32
#
# WARNING: This default value is dev-grade only. Replace before any
# deployment that handles real data.
STACK_JWT_SECRET_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Chronos scope used by the prom2chronos bridge AND the Olymp loop.
# Both sides must agree, or signals land somewhere Olymp can't see.
# Any uuid works for the demo; replace per environment in production.
DEMO_CHRONOS_SCOPE_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa

# Local LLM for Nous's commitment extractor. Defaults route to a
# bundled Ollama daemon at http://ollama:11434/v1 with model llama3.2
# (~2 GB, pulled on first /v1/extract call). Override the model for
# a smaller pull (e.g. NOUS_LLM_MODEL=llama3.2:1b). Set
# NOUS_LLM_PROVIDER="" to fall back to the deterministic
# ScriptedExtractor when running offline.
NOUS_LLM_PROVIDER=ollama
NOUS_LLM_BASE_URL=http://ollama:11434/v1
NOUS_LLM_MODEL=llama3.2
